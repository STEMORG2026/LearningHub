{
  "name": "@learninghub/lesson-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Lesson renderer — stem-lesson Web Component for rendering LessonContent",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@learninghub/content-provider": "workspace:*",
    "@learninghub/core": "workspace:*",
    "@learninghub/tracer": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
