{
  "name": "@stem-tuition/interactive-simulations",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive simulations — Web Components wrapping simulation-core for mechanics, circuits, optics",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
