{
  "name": "stem-tuition",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "STEM-TUITION — Modular STEM education platform",
  "scripts": {
    "dev:shell": "turbo dev --filter=@stem-tuition/shell",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:arch": "dependency-cruise packages/ apps/",
    "lint:circular": "madge --circular --extensions ts --exclude 'dist|coverage|node_modules' packages apps",
    "lint:size": "node scripts/checks/size-check.cjs",
    "lint:state": "eslint --no-config-lookup --config eslint.config.state.mjs 'packages/**/src/**/*.ts' 'apps/**/src/**/*.ts'",
    "lint:dom": "eslint --no-config-lookup --config eslint.config.dom.mjs 'packages/**/src/**/*.ts' 'apps/**/src/**/*.ts'",
    "lint:registry": "node scripts/checks/verify-registry.js",
    "typecheck": "turbo typecheck",
    "test:a11y": "playwright test --config=playwright.config.ts --grep-invert 'visual-regression'",
    "validate:edu": "node scripts/checks/validate-educational-metadata.js",
    "verify-governance": "pnpm lint:arch && pnpm lint:circular && pnpm lint:state && pnpm lint:dom && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm test:a11y && pnpm lint:size && pnpm validate:edu && pnpm lint:registry",
    "quick": "pnpm lint:arch && pnpm lint:circular && pnpm lint:state && pnpm lint:dom && pnpm typecheck",
    "check": "pnpm quick && pnpm test",
    "size": "pnpm build && pnpm lint:size",
    "generate:graph": "dependency-cruise --output-type dot packages/ apps/ | dot -T svg -o docs/dependency-graph.svg",
    "changeset": "changeset",
    "dev-version": "node scripts/release/dev-version.mjs",
    "sync-versions": "node scripts/generate/sync-versions.mjs",
    "sync:lhs": "node scripts/generate/sync-lhs-knowledge.mjs",
    "docs:sync": "node scripts/generate/docs-sync.mjs && node scripts/generate/sync-versions.mjs && node scripts/generate/generate-health.mjs && node scripts/generate/generate-tree.mjs",
    "setup-hooks": "git config core.hooksPath scripts/git-hooks",
    "release:prepare": "node scripts/release/release-prepare.mjs",
    "release:validate": "node scripts/release/release-validate.mjs",
    "release:version": "node scripts/release/release-version.mjs",
    "release:finalize": "node scripts/release/release-finalize.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "changeset:version": "echo 'ERROR: Direct changeset version is disabled. Use the 4-stage release pipeline:' && echo '  pnpm release:prepare  →  pnpm release:validate  →  pnpm release:version  →  pnpm release:finalize' && exit 1",
    "changeset:publish": "changeset publish",
    "lint:commit": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.44.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.6",
    "axe-core": "^4.9.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "madge": "^8.0.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
