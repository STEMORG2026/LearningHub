# LearningHub — environment configuration
#
# Copy to `.env` for local runs (`cp .env.example .env`). `.env` is gitignored;
# this file is the committed contract listing every variable the apps read.
#
# ─────────────────────────────────────────────────────────────────────────────
# WARNING — anything prefixed `VITE_` is inlined into the browser bundle
# ─────────────────────────────────────────────────────────────────────────────
# Vite substitutes `VITE_*` values at build time, so they end up in `dist/` as
# plaintext and are visible to anyone who loads the site. Treat them as public
# configuration, not secrets. A key that must stay private belongs behind a
# server-side proxy, never in this file.

# ── Shell app (apps/shell) ───────────────────────────────────────────────────

# Optional. Base URL of the PROFESSOR-J backend, read by the chat client
# (src/lib/professor-j-client.ts → getBackendUrl()). Resolution order is:
# explicit `baseUrl` argument → this variable → same-origin (empty string).
# Leave unset to keep requests same-origin.
VITE_PROFESSOR_J_URL=

# ── Tooling / CI ─────────────────────────────────────────────────────────────

# Optional. Token for the authenticated release pipeline
# (scripts/release/*). Not read by the app at runtime.
# GITHUB_TOKEN=

# Optional. Cloudflare Pages deploy credentials, used only by CI
# (`.github/workflows/deploy.yml`) and `wrangler`.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
