#!/bin/sh
# pre-push — the last local barrier before code leaves this machine.
#
# This is the LOCAL tier of a ladder that ends in GitHub Actions. It runs the
# FAST tier of `scripts/ci-local.mjs`: every lint, build, typecheck, test, and
# audit stage, but NOT the slow coverage/E2E/mutation runs.
#
# It is a fast pre-flight, not the authority. CI (`.github/workflows/ci.yml`) is
# the authority and runs the full set — a green push here does not guarantee a
# green CI, only that the cheap defects are already gone.
#
# Bypass deliberately, never routinely:
#   git push --no-verify
set -e

echo "[pre-push] running local CI (fast tier)…"
if ! pnpm ci:local:fast; then
  echo ""
  echo "[pre-push] ❌ local CI failed — push blocked."
  echo "[pre-push]    Fix the failure above, or 'git push --no-verify' to override."
  exit 1
fi
echo "[pre-push] ✅ local CI green"
