#!/bin/sh
# pre-push — the middle tier of the governance ladder.
#
# The ladder is strictly nested, cheapest first:
#
#   gate:precommit  ⊆  gate:prepush  ⊆  verify-governance (CI)
#
# `pnpm gate:prepush` includes every `gate:precommit` stage, plus build, the
# unit suite, the structural guards (branch rule, gate integrity, work record,
# coverage ratchet), the docs-sync and dependency audits, and the workflow lint.
# What it does NOT include is the expensive end: coverage thresholds, Playwright
# accessibility, the mutation run, and the flake proof. Those are CI's job.
#
# This is a pre-flight, not the authority. CI runs the full tier; passing here
# means the cheap defects are already gone, not that the change is good.
#
# Bypass deliberately, never routinely:
#   git push --no-verify
set -e

echo "[pre-push] running the gate:prepush tier…"
if ! pnpm gate:prepush; then
  echo ""
  echo "[pre-push] ❌ gate:prepush failed — push blocked."
  echo "[pre-push]    Fix the failure above, or 'git push --no-verify' to override."
  exit 1
fi
echo "[pre-push] ✅ gate:prepush green"
