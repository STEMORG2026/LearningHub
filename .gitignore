# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Turbo
.turbo/

# Coverage
coverage/

# Legacy (tracked separately)
legacy/js/*.map

# Generated build artifacts in source directories
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map
# Maintained, hand-authored Vite declaration file (committed by design, unlike the
# generated `*.d.ts` build artifacts above).
!apps/*/src/vite-env.d.ts

# Temp
tmp/
temp/
# Ephemeral temp files/dirs created by test runners and sandboxed tooling at the
# repo root (e.g. `_tmp_<pid>_<hash>`). The directory patterns above do not match
# root-level files, so these were leaking into `git status` as untracked.
_tmp_*

# Local agent/session data. Not repository content: it exists only on a developer's
# machine, so it must not appear in the generated `tree.txt`, which CI compares
# against a fresh checkout that has no such directory.
.workbuddy-ai/

# Release pipeline
.release-token.json

# Playwright
test-results/
playwright-report/

# Lighthouse CI
.lighthouseci/
lhci-reports/

# Generated documentation (regenerate with pnpm generate:graph; CI enforces freshness)
docs/dependency-graph.svg

# repo-local pnpm store + config (global store index.db unreadable by node:sqlite)
.npmrc
.pnpm-store/
